__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

.secrets.env
.venv
.idea/

# Golden fixtures capture everything the Claude target writes, including the
# .claude/ tree and .claude.json a global ignore may exclude. Keep the
# checked-in goldens tracked regardless.
!tests/golden/**/.claude/
!tests/golden/**/.claude.json
!tests/golden/**/CLAUDE.md
