version: "0.1"
name: team

agents:
  reviewer:
    persona: agents/reviewer.md
    allowed_tools: [Read, Edit, "mcp__github__*"]
    depends_on:
      skills: [lint]

skills:
  lint:
    path: skills/lint
    depends_on:
      skills: [format]
  format:
    path: skills/format

mcps:
  github:
    type: stdio
    command: gh-mcp
    args: [serve]
