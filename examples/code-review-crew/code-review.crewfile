version: "0.1"

# A single-agent code-review crew. The reviewer depends on one skill;
# everything else — the transitive skill and the shared MCP — is pulled in
# through each skill's SKILL.md `x-crewspec` frontmatter (the dependency floor).
agents:
  reviewer:
    persona: agents/reviewer.md
    allowed_tools: [Read, Grep, Bash]
    depends_on:
      skills: [code-review]

# Skills are registered here by map key with just a path; their dependencies
# live in each skill's frontmatter so the skill stays portable across crews.
skills:
  code-review:
    path: skills/code-review
  test-analysis:
    path: skills/test-analysis

# One MCP, depended on by both skills. The resolver dedups it to a single entry
# in the emitted plugin. The token is kept out of the spec via a secret
# reference; the launcher injects GITHUB_TOKEN at runtime.
mcps:
  github:
    type: stdio
    command: npx
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "${secret:GITHUB_TOKEN}"
