version: "0.1"
name: code-review-crew

# Global instructions. On the Claude target this file becomes a managed block
# in ~/.claude/CLAUDE.md (between crewspec markers); nothing else in that
# file is touched.
instructions: instructions.md

# A single-agent code-review crew. The reviewer lists the skill its agent file
# should name; every skill under `skills:` and every server under `mcps:` is
# installed regardless. Dependency edges (here and in each skill's
# `x-crewspec` frontmatter) are reference checks: an unknown name is an error.
agents:
  reviewer:
    persona: agents/reviewer.md
    allowed_tools: [Read, Grep, Bash]
    depends_on:
      skills: [code-review]

# Skills are registered here by map key with just a path; their dependencies
# live in each skill's frontmatter so the skill stays portable across crews.
skills:
  code-review:
    path: skills/code-review
  test-analysis:
    path: skills/test-analysis

# MCP servers are global: each one is merged into the user-scope config
# (~/.claude.json on Claude). The token is kept out of the spec via a secret
# reference; the launcher injects GITHUB_TOKEN at runtime.
mcps:
  github:
    type: stdio
    command: npx
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "${secret:GITHUB_TOKEN}"
