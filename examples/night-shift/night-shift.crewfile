version: "0.2"
name: night-shift

agents:
  night-shift:
    persona: agents/night-shift.md
    allowed_tools:
      - Read
      - Edit
      - Write
      - Grep
      - Glob
      - Bash
      # D5: enumerated, not mcp__github__*. No merge_pull_request, no update_pull_request (un-draft).
      - mcp__github__get_issue
      - mcp__github__create_branch
      - mcp__github__push_files
      - mcp__github__create_pull_request
      - mcp__github__add_issue_comment
      - mcp__github__update_issue
    depends_on:
      skills: [issue-to-pr]
    # ---- 0.2 blocks below; 0.1 crewspec rejects every one (extra="forbid") ----
    triggers:
      - provider: github
        type: label_change
        filter: {label: night-shift}            # repo comes from the github channel binding
        coalesce: {key: issue.number, window_s: 120, max_wait_s: 600}
        deliver_only: false
        run: {fresh_session: true}
        on_failure: {auto_disable_after: 3, notify: channel}
      - provider: cron
        cron: "0 1 * * *"              # nightly sweep of anything still labelled
    channels:
      - kind: slack
        binding: {workspace: T0123, channel: C0456}
        approvals_inbox: true
      - kind: github
        binding: {repo: kennedlj/Operative}
    sandbox:
      kind: docker
      scope: run                       # D1: one container per run
      required: true
      policy: workspace-write
      network: broker-only             # D4: no raw egress
      host_access: none
      disk_mb: 4096
      leaves:
        hidden: [~/.ssh, .env]
        readonly: [crewfile]
    secrets:
      github_token:
        ref: vault://github/night-shift
        blind: true                    # D4
        hosts: [api.github.com]
      slack_bot:
        ref: vault://slack/night-shift
        blind: false                   # D4 declared exception: server process needs the real value
        hosts: [slack.com]
    limits:
      deny: ["gh pr merge*", "git push --force*", "gh pr ready*"]   # D5: no merge, no self-promote
      wall_clock_s: 3600
      tokens_per_run: 200000
      tokens_per_day: 2000000
      max_prs_per_night: 5
    approvals:
      policy: on-request
      ask: [delete]                    # D5: merge/promote are denied, so never asked
      deferred: true
      timeout_s: 1800
      on_timeout: deny                 # D5
      unattended: deny
    x-operative:
      backend: claude_code             # D7d: emitter is the adapter
      memory_policy: {write: broad, read: persona-curated}
      model: claude-opus-5-5
      labels: {claim: "night-shift:working", failed: "night-shift:failed"}   # D5

skills:
  issue-to-pr:
    path: skills/issue-to-pr

mcps:
  github:
    type: stdio
    command: npx
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "${secret:github_token}"
  slack:
    type: stdio
    command: npx
    args: ["-y", "@modelcontextprotocol/server-slack"]
    env:
      SLACK_BOT_TOKEN: "${secret:slack_bot}"
